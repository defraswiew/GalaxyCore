<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<!-- Requires a matching UNIGINE SDK/native deployment validated for the .NET 8 host. -->
		<GalaxySdkPath>$(MSBuildThisFileDirectory)..\..\..\Core\Client\Managed\netstandard2.1</GalaxySdkPath>
		<UnigineBinPath Condition="'$(UnigineBinPath)' == ''">$(MSBuildThisFileDirectory)bin</UnigineBinPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RootNamespace>UnigineApp</RootNamespace>
		<StartupObject>UnigineApp.UnigineApp</StartupObject>
		<WarningLevel>4</WarningLevel>
		<OutputPath>bin</OutputPath>
		<EnableDefaultItems>false</EnableDefaultItems>
		<SkipPostBuild>false</SkipPostBuild>
		<PlatformTarget>x64</PlatformTarget>
		<DebugType>portable</DebugType>
		<DOTNET_HOST_PATH Condition="&apos;$(DOTNET_HOST_PATH)&apos; == &apos;&apos;">dotnet</DOTNET_HOST_PATH>
	</PropertyGroup>
	<PropertyGroup Condition="&apos;$(Configuration)&apos;==&apos;Debug&apos;">
		<AssemblyName>GalaxyNetworkTemplate_x64d</AssemblyName>
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE;DEBUG;</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="&apos;$(Configuration)&apos;==&apos;Debug&apos;">
		<Reference Include="UnigineSharp_x64d">
			<SpecificVersion>false</SpecificVersion>
			<HintPath>$(UnigineBinPath)\UnigineSharp_x64d.dll</HintPath>
		</Reference>
	</ItemGroup>
	<PropertyGroup Condition="&apos;$(Configuration)&apos;==&apos;Release&apos;">
		<AssemblyName>GalaxyNetworkTemplate_x64</AssemblyName>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;NDEBUG;</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="&apos;$(Configuration)&apos;==&apos;Release&apos;">
		<Reference Include="UnigineSharp_x64">
			<SpecificVersion>false</SpecificVersion>
			<HintPath>$(UnigineBinPath)\UnigineSharp_x64.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="data/csharp_template/first_person_controller/components/FirstPersonController.cs"/>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="source\AppEditorLogic.cs"/>
		<Compile Include="source\AppSystemLogic.cs"/>
		<Compile Include="source\AppWorldLogic.cs"/>
		<Compile Include="source\GalaxyNetwork\UI\UIChat.cs"/>
		<Compile Include="source\GalaxyNetwork\UI\UIInstances.cs"/>
		<Compile Include="source\GalaxyNetwork\UI\UILogin.cs"/>
		<Compile Include="source\GalaxyNetwork\UI\UIStatistics.cs"/>
		<Compile Include="source\GalaxyNetwork\UnigineGalaxyNetwork.cs"/>
		<Compile Include="source\main.cs"/>
	</ItemGroup>
	<ItemGroup>
		<Reference Include="GalaxyCoreCommon">
			<HintPath>$(GalaxySdkPath)\GalaxyCoreCommon.dll</HintPath>
		</Reference>
		<Reference Include="GalaxyCoreLib">
			<HintPath>$(GalaxySdkPath)\GalaxyCoreLib.dll</HintPath>
		</Reference>
		<Reference Include="protobuf-net">
			<HintPath>$(GalaxySdkPath)\protobuf-net.dll</HintPath>
		</Reference>
		<ProjectReference Include="..\..\SimpleMmoServer\SimpleMmoCommon\SimpleMmoCommon.csproj"/>
	</ItemGroup>
	<Target Name="ValidateEngineSdk" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="'$(Configuration)' == 'Debug' And !Exists('$(UnigineBinPath)\UnigineSharp_x64d.dll')" Text="UNIGINE debug SDK is missing. Supply a UNIGINE C# SDK/native deployment compatible with .NET 8 in bin, or set UnigineBinPath. The included 2.15.1 engine assets require SDK migration and runtime validation."/>
		<Error Condition="'$(Configuration)' == 'Release' And !Exists('$(UnigineBinPath)\UnigineSharp_x64.dll')" Text="UNIGINE release SDK is missing. Supply a UNIGINE C# SDK/native deployment compatible with .NET 8 in bin, or set UnigineBinPath. The included 2.15.1 engine assets require SDK migration and runtime validation."/>
	</Target>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(UnigineBinPath)\cspropgen_x64d.dll&quot; -p &quot;$(TargetPath)&quot; -data_path &quot;$(MSBuildProjectDirectory)/data/&quot;" Condition="&apos;$(Configuration)&apos;==&apos;Debug&apos; And $(SkipPostBuild)==&apos;false&apos;"/>
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(UnigineBinPath)\cspropgen_x64.dll&quot; -p &quot;$(TargetPath)&quot; -data_path &quot;$(MSBuildProjectDirectory)/data/&quot;" Condition="&apos;$(Configuration)&apos;==&apos;Release&apos; And $(SkipPostBuild)==&apos;false&apos;"/>
	</Target>
</Project>
